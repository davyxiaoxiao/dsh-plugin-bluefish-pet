{
  "name": "dsh-bluefish-pet",
  "version": "1.1.0",
  "description": "启动 / 显示 / 隐藏 / 退出鲸鱼娘桌面宠物（DSH 斜杠命令，macOS + Windows）",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "desktop-pet",
    "bluefish"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davyxiaoxiao/dsh-plugin-bluefish-pet.git"
  },
  "homepage": "https://github.com/davyxiaoxiao/dsh-plugin-bluefish-pet#readme",
  "bugs": {
    "url": "https://github.com/davyxiaoxiao/dsh-plugin-bluefish-pet/issues"
  }
}
